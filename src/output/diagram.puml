@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/Archimate-PlantUML/master/Archimate.puml
Application_Component(DOGECOIN, "DOGECOIN")
Application_Function(00000_MAIN, "00000-MAIN")
Rel_Composition(DOGECOIN, 00000_MAIN)
Application_Function(DOGE_WTO, "DOGE-WTO")
Rel_Triggering(00000_MAIN, DOGE_WTO)
Application_Function(DOGE_MAIN_SCREEN, "DOGE-MAIN-SCREEN")
Rel_Triggering(00000_MAIN, DOGE_MAIN_SCREEN)
Application_Function(PARSE_OPTION, "PARSE-OPTION")
Rel_Triggering(00000_MAIN, PARSE_OPTION)
Application_Function(RECEIVE_OPTION, "RECEIVE-OPTION")
Rel_Triggering(00000_MAIN, RECEIVE_OPTION)
Application_Function(DOGE_EXIT, "DOGE-EXIT")
Rel_Composition(DOGECOIN, DOGE_EXIT)
Rel_Composition(DOGECOIN, RECEIVE_OPTION)
Rel_Triggering(RECEIVE_OPTION, DOGE_WTO)
Rel_Composition(DOGECOIN, PARSE_OPTION)
Rel_Triggering(PARSE_OPTION, DOGE_WTO)
Rel_Composition(DOGECOIN, DOGE_MAIN_SCREEN)
Application_Function(CONVERT_AMOUNT_TO_DISPLAY, "CONVERT-AMOUNT-TO-DISPLAY")
Rel_Triggering(DOGE_MAIN_SCREEN, CONVERT_AMOUNT_TO_DISPLAY)
Application_Function(CONVERT_DATE, "CONVERT-DATE")
Rel_Triggering(DOGE_MAIN_SCREEN, CONVERT_DATE)
Rel_Triggering(DOGE_MAIN_SCREEN, DOGE_WTO)
Rel_Composition(DOGECOIN, CONVERT_AMOUNT_TO_DISPLAY)
Rel_Composition(DOGECOIN, CONVERT_DATE)
Rel_Composition(DOGECOIN, DOGE_WTO)

Group(CICS, "CICS Services") {
Application_Component(ENDBR, "ENDBR")
Application_Component(FORMATTIME, "FORMATTIME")
Application_Component(READNEXT, "READNEXT")
Application_Component(READPREV, "READPREV")
Application_Component(RECEIVE, "RECEIVE")
Application_Component(RESETBR, "RESETBR")
Application_Component(RETURN, "RETURN")
Application_Component(SEND, "SEND")
Application_Component(STARTBR, "STARTBR")
Application_Component(WTO, "WTO")
}

Group(COBOL_Programs, "Other COBOL Programs") {
Application_Component(DOGEDEET, "DOGEDEET")
Application_Component(DOGEQUIT, "DOGEQUIT")
Application_Component(DOGESEND, "DOGESEND")
Application_Component(DOGETRAN, "DOGETRAN")
}
Rel_Serving(RETURN, 00000_MAIN)
Rel_Serving(SEND, 00000_MAIN)
Rel_Triggering(00000_MAIN, DOGEQUIT)
Rel_Serving(RECEIVE, RECEIVE_OPTION)
Rel_Triggering(PARSE_OPTION, DOGETRAN)
Rel_Triggering(PARSE_OPTION, DOGECOIN)
Rel_Triggering(PARSE_OPTION, DOGEDEET)
Rel_Triggering(PARSE_OPTION, DOGESEND)
Rel_Serving(ENDBR, DOGE_MAIN_SCREEN)
Rel_Serving(READNEXT, DOGE_MAIN_SCREEN)
Rel_Serving(READPREV, DOGE_MAIN_SCREEN)
Rel_Serving(RESETBR, DOGE_MAIN_SCREEN)
Rel_Serving(SEND, DOGE_MAIN_SCREEN)
Rel_Serving(STARTBR, DOGE_MAIN_SCREEN)
Rel_Serving(FORMATTIME, CONVERT_DATE)
Rel_Serving(WTO, DOGE_WTO)
@enduml